{
  "expo": {
    "name": "Hayvan Dili",
    "slug": "hayvan-dili",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hayvan-dili",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8ee"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.influx7.hayvandili",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hayvanının sesini kaydedip çevirebilmek için mikrofona erişim gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "23237667-3ef9-44e0-8d97-119428deb60b"
      }
    },
    "owner": "influx7"
  }
}
